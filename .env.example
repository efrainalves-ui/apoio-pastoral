# Modelo de ambiente. Este arquivo entra no Git e por isso não pode ter valores.
# Copie para .env.local no computador privado do avaliador e preencha lá.
# .env.local é ignorado pelo Git.

# Sem estas duas variáveis, o aplicativo usa o transporte local de desenvolvimento
# e nada sai do dispositivo.
# Use SEMPRE um projeto Supabase novo, vazio e marcado como homologação.
# Nunca aponte para produção e nunca use a chave service_role no navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_APP_ENV=

# Deixe VITE_DISABLE_SYNC=true para manter tudo local.
# Só mude para false na rodada de homologação em nuvem com contas fictícias.
VITE_DISABLE_SYNC=
